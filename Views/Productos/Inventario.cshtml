@model List<Producto>
@{
    ViewData["Title"] = "Inventario";
}

<div class="page-head">
    <h1>Inventario</h1>
    <p class="muted small" style="margin:0">Productos con stock de @Negocio.StockBajo unidades o menos aparecen como alerta.</p>
</div>

<section class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Producto</th><th>Estado</th><th class="num">Stock actual</th><th>Actualizar stock</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Nombre</td>
                        <td>
                            @if (p.Stock == 0) { <span class="status out">Agotado</span> }
                            else if (p.Stock <= Negocio.StockBajo) { <span class="status low">Stock bajo</span> }
                            else { <span class="status ok">Disponible</span> }
                        </td>
                        <td class="num">@p.Stock</td>
                        <td>
                            <form asp-action="ActualizarStock" method="post" class="filters">
                                <input type="hidden" name="id" value="@p.Id" />
                                <input type="number" name="stock" min="0" value="@p.Stock" aria-label="Nuevo stock de @p.Nombre" style="max-width:110px" />
                                <button type="submit" class="btn btn-outline btn-sm">Guardar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
