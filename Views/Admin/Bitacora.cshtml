@model List<Bitacora>
@{
    ViewData["Title"] = "Bitácora";
}

<h1>Bitácora de actividades</h1>
<p class="muted small">Últimos 300 registros: altas, bajas, modificaciones, compras y accesos.</p>

<section class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Detalle</th></tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(b.Usuario?.Email ?? "Sistema")</td>
                        <td>@b.Accion</td>
                        <td class="muted">@b.Detalle</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
