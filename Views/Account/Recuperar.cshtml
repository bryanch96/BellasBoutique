@model RecuperarVm
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_AuthLayout";
}

<section class="card auth-card">
    <h1>Recuperar contraseña</h1>
    <p class="muted small">Ingrese su correo electrónico y le enviaremos una nueva contraseña generada automáticamente.</p>

    @if (ViewData["Error"] is string error)
    {
        <div class="alert alert-error" role="alert">@error</div>
    }

    <form asp-action="Recuperar" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <div class="field">
            <label asp-for="Email">Correo electrónico</label>
            <input asp-for="Email" placeholder="correo@ejemplo.com" autocomplete="username" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-brand btn-block">Enviar nueva contraseña</button>
        <p class="small center" style="margin-top:16px"><a asp-action="Login">Volver a iniciar sesión</a></p>
    </form>
</section>
